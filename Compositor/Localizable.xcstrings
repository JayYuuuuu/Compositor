          "stringUnit": {
            "state": "translated",
            "value": "拖移以调整面板大小"
          }
        }
      }
    },
    "Drag to set hue and saturation. Double-click to reset this wheel.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以设置色相和饱和度。双击可重置此色轮。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to set hue and saturation. Double-click to reset this wheel."
          }
        }
      }
    },
    "Drag up or down to lift or lower those tones. Drag a divider along the bottom to change which tones each region covers.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向上或向下拖动以提升或降低这些色调。沿底部拖动分隔线可更改每个区域覆盖的色调。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag up or down to lift or lower those tones. Drag a divider along the bottom to change which tones each region covers."
          }
        }
      }
    },
    "Draw Guides": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绘制参考线"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw Guides"
          }
        }
      }
    },
    "Draw each chunky pixel as a solid square, or as a round dot like a dot-matrix screen": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将每个粗像素绘制为实心方块，或绘制为圆点，如同点阵屏幕"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draw each chunky pixel as a solid square, or as a round dot like a dot-matrix screen"
          }
        }
      }
    },
    "Draw no line where the picture is darker than this, leaving the screen dark": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画面比此值更暗处不绘制线条，使屏幕保持黑暗"
