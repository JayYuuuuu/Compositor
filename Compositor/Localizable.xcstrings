    "Drag a color in the picture. Nearby color families move together.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在画面中拖动一种颜色。相近的色系会一起移动。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a color in the picture. Nearby color families move together."
          }
        }
      }
    },
    "Drag a point. Click to add one. Double-click a point to remove it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动一个点。单击可添加一个点。双击一个点可将其移除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag a point. Click to add one. Double-click a point to remove it."
          }
        }
      }
    },
    "Drag inside the wheel. Angle sets hue, distance sets saturation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在色轮内拖动。角度决定色相，距离决定饱和度。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag inside the wheel. Angle sets hue, distance sets saturation."
          }
        }
      }
    },
    "Drag on the layer to place a guide. Draw at least two lines.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图层上拖动以放置参考线。至少绘制两条线。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag on the layer to place a guide. Draw at least two lines."
          }
        }
      }
    },
    "Drag or scroll to move around; double-click switches between Fit and 100%": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag or scroll to move around; double-click switches between Fit and 100%"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖移或滚动以移动预览；连按切换适合窗口与 100%"
          }
        }
      }
    },
    "Drag to resize the panel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to resize the panel"
          }
