    },
    "How bright the lines are where the picture is black, so they show even over black": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "画面为黑色时线条的亮度，使其即使在黑色上也能显示"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How bright the lines are where the picture is black, so they show even over black"
          }
        }
      }
    },
    "How far a color may be from the picked ones and still be selected": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "颜色与所选颜色的差异在多大范围内仍会被选中"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far a color may be from the picked ones and still be selected"
          }
        }
      }
    },
    "How far apart the screen's lines are": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏幕线条的间距"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far apart the screen's lines are"
          }
        }
      }
    },
    "How far each color channel (0–255) can differ from the clicked color and still be selected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far each color channel (0–255) can differ from the clicked color and still be selected"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个颜色通道（0–255）与点按颜色之间允许的差异"
          }
        }
      }
    },
    "How far the blur softens, in pixels": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far the blur softens, in pixels"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模糊范围，以像素为单位"
          }
        }
      }
    },
    "How far the brightness is smoothed before it displaces the lines, from sharp ridges to rounded hills": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "亮度在置换线条前的平滑程度，从锐利的山脊到圆润的山丘"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far the brightness is smoothed before it displaces the lines, from sharp ridges to rounded hills"
          }
        }
      }
    },
    "How much of each pixel's error spreads to its neighbors. Less gives flatter areas": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个像素的误差扩散到相邻像素的比例。数值越小，区域越平坦"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much of each pixel's error spreads to its neighbors. Less gives flatter areas"
          }
        }
      }
    },
    "How much of the gap a bright line fills; dimmer parts draw it thinner": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "亮线填充间隙的比例；较暗的部分绘制的线条更细"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How much of the gap a bright line fills; dimmer parts draw it thinner"
          }
        }
      }
    },
